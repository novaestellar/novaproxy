# Normalize line endings across platforms; keep binaries byte-exact.
* text=auto eol=lf

*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.svg  text eol=lf
*.sh   text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.jfif binary
*.webp binary
*.ico  binary
*.woff2 binary
*.mp4  binary
*.db   binary

# Generated bundles: do not diff, do not merge by line.
# `*` does not cross `/` in gitattributes, so both levels are named.
web/dist/*.js          -diff merge=ours
web/dist/*.css         -diff merge=ours
web/dist/**/*.js       -diff merge=ours
web/dist/**/*.css      -diff merge=ours
web/dist/index.html    -diff merge=ours
