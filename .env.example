# NovaProxy runtime configuration
# Copy to .env (git-ignored) and adjust. All values optional.

# SQLite database path
NP_DB=novaproxy.db

# Bootstrap admin — used ONLY when the users table is empty.
# Set a strong password before the first start.
NP_ADMIN_USER=admin
NP_ADMIN_PASS=change-me

# Optional: headless browser for signup-gated sources
#   playwright install chromium
