# novaproxy runtime configuration
# Copy to .env (git-ignored) and adjust. Every value is optional.

# ---- database ----
# SQLite file. WAL mode is enabled at boot; keep it on a local disk.
NP_DB=novaproxy.db

# ---- console (web UI + JSON API) ----
# Bind host. 127.0.0.1 keeps the console on this machine only.
NP_HOST=127.0.0.1
# Console port. The gateway listeners sit above it (see below).
NP_PORT=12000
# uvicorn log level: critical | error | warning | info | debug
NP_LOG=info

# ---- auth ----
# local = requests from 127.0.0.1 are the operator, no sign-in screen.
# on    = always require a session, even on loopback.
NP_AUTH=local

# Bootstrap admin, created ONLY while the users table is empty.
# With NP_AUTH=local these credentials are not prompted for, but they are the
# identity every loopback request is attributed to. Set a real password before
# exposing the console to anything but this machine.
NP_ADMIN_USER=admin
NP_ADMIN_PASS=change-me

# ---- gateway defaults (first boot only; afterwards the UI/database wins) ----
# SOCKS5 listener and HTTP listener. override in the Gateway page.
# NP_SOCKS_PORT=11500
# NP_HTTP_PORT=12500

# ---- optional: signup-gated sources ----
# Only needed if you configure SIGNUP_SOURCES in app/config.py.
#   playwright install chromium
